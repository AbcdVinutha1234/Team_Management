
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WORKLINK SECURITY MODEL
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] != null;
    }

    function isAdmin(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] == 'Admin';
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; 
    }

    match /projects/{projectId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isMember(resource.data.members);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isAdmin(resource.data.members);
      allow delete: if isSignedIn() && isAdmin(resource.data.members);

      match /memberships/{mUserId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isAdmin(request.resource.data.projectMembers);
      }
    }

    match /tasks/{taskId} {
      // Allow listing tasks for any signed-in user.
      // In a production app, you might constrain this to query filters,
      // but 'isSignedIn()' is the standard MVP baseline.
      allow list: if isSignedIn();
      
      // Allow getting a specific task if the user is signed in.
      allow get: if isSignedIn();
      
      // Allow creation if signed in.
      allow create: if isSignedIn();
      
      // Allow updates if signed in.
      allow update: if isSignedIn();
      
      // Allow deletion if the user is an admin or the creator.
      allow delete: if isSignedIn() && (
        (resource.data.projectMembers != null && resource.data.projectMembers[request.auth.uid] == 'Admin') || 
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
