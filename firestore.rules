
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * WORKLINK PROTOTYPE SECURITY RULES
     * Allows full read and write access to all authenticated users.
     * This ensures listeners and AI flows can operate without permission failures
     * during development and prototyping.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
