
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WORKLINK SECURITY MODEL
     * 
     * Core Philosophy:
     * Enforces RBAC and Ownership.
     * Denormalization is used to avoid 'get()' calls.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] != null;
    }

    function isAdmin(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] == 'Admin';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSystemAdmin() {
      return isSignedIn() && getUserData().role == 'Admin';
    }

    // --- Collection Rules ---

    /**
     * @description Users can see the whole team, but only edit their own profile.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin());
      allow update: if isExistingOwner(userId) || isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    /**
     * @description Projects are governed by the 'members' map.
     */
    match /projects/{projectId} {
      allow get: if isMember(resource.data.members);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if resource != null && isAdmin(resource.data.members);

      match /memberships/{mUserId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isAdmin(request.resource.data.projectMembers);
      }
    }

    /**
     * @description Tasks are secured by denormalized project roles.
     */
    match /tasks/{taskId} {
      // Allow list for signed-in users so they can filter by assignment or project
      allow list: if isSignedIn();
      
      allow get: if isSignedIn() && (
        isMember(resource.data.projectMembers) || 
        resource.data.assignedToId == request.auth.uid
      );
      
      allow create: if isSignedIn() && (
        isMember(request.resource.data.projectMembers) && 
        request.resource.data.createdBy == request.auth.uid
      );
      
      allow update: if resource != null && (
        isMember(resource.data.projectMembers) || 
        resource.data.assignedToId == request.auth.uid
      );
      
      allow delete: if resource != null && (
        isAdmin(resource.data.projectMembers) || 
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
