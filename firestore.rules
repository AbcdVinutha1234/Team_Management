
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WORKLINK SECURITY MODEL
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] != null;
    }

    function isAdmin(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] == 'Admin';
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; 
    }

    match /projects/{projectId} {
      // Allow listing projects if signed in. 
      // Users will typically query projects where they are members.
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isMember(resource.data.members);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isAdmin(resource.data.members);
      allow delete: if isSignedIn() && isAdmin(resource.data.members);

      match /memberships/{mUserId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isAdmin(request.resource.data.projectMembers);
      }
    }

    match /tasks/{taskId} {
      // Allow listing tasks for any signed-in user.
      allow list: if isSignedIn();
      
      // Allow getting a specific task if the user is a member of the project or assigned.
      allow get: if isSignedIn() && (
        resource.data.assignedToId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        isMember(resource.data.projectMembers)
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.assignedToId == request.auth.uid || 
        isMember(resource.data.projectMembers)
      );
      
      allow delete: if isSignedIn() && (
        isAdmin(resource.data.projectMembers) || 
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
