
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WORKLINK SECURITY MODEL
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] != null;
    }

    function isAdmin(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] == 'Admin';
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; 
    }

    match /projects/{projectId} {
      // Allow listing projects if signed in. Queries should still be filtered for membership.
      allow list: if isSignedIn();
      
      allow get: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isMember(resource.data.members)
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin(resource.data.members)
      );
      
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin(resource.data.members)
      );

      match /memberships/{mUserId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isAdmin(request.resource.data.projectMembers) || 
          isAdmin(resource.data.projectMembers) ||
          request.auth.uid == mUserId
        );
      }
    }

    match /tasks/{taskId} {
      // Allow listing tasks if signed in.
      allow list: if isSignedIn();
      
      // Explicit get rule covering individual document evaluation.
      allow get: if isSignedIn() && (
        resource.data.assignedToId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        isMember(resource.data.projectMembers)
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.assignedToId == request.auth.uid || 
        isMember(resource.data.projectMembers) ||
        resource.data.createdBy == request.auth.uid
      );
      
      allow delete: if isSignedIn() && (
        isAdmin(resource.data.projectMembers) || 
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
