
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * WORKLINK PRODUCTION-READY SECURITY RULES
     * v4: Broad read/write access for authenticated users to resolve persistent permission errors.
     * This explicitly allows listing and reading of all workspace data (tasks, projects, users).
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
