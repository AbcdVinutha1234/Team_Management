
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WORKLINK SECURITY MODEL
     * Updated to ensure robust permissions for authenticated queries.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] != null;
    }

    function isAdmin(memberMap) {
      const role = memberMap[request.auth.uid];
      return isSignedIn() && (role == 'Admin' || role == 'Owner');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; 
    }

    match /projects/{projectId} {
      // Allow signed-in users to list/get projects. 
      // Filtered views handled in-app by membership.
      allow read: if isSignedIn();
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin(resource.data.members)
      );
      
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin(resource.data.members)
      );

      match /memberships/{mUserId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    match /tasks/{taskId} {
      // Simplified read permission for authenticated users to support all query patterns.
      allow read: if isSignedIn();
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.assignedToId == request.auth.uid || 
        isMember(resource.data.projectMembers) ||
        resource.data.createdBy == request.auth.uid
      );
      
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin(resource.data.projectMembers)
      );
    }
  }
}
