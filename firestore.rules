
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * WORKLINK SECURITY MODEL
     * Highly permissive read for all authenticated users to ensure stability during MVP development.
     * Write access restricted based on common sense logic for a collaborative workspace.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Allow any signed-in user to see team profiles
      allow read: if isSignedIn();
      // Only the user can update their own profile
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      // Allow any signed-in user to read and list projects
      allow read: if isSignedIn();
      // Allow project creation and modification for now to keep prototyping simple
      allow write: if isSignedIn();
    }

    match /tasks/{taskId} {
      // Allow any signed-in user to read and list tasks
      allow read: if isSignedIn();
      // Allow task management for signed-in users
      allow write: if isSignedIn();
    }

    // Fallback for any other collection
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
