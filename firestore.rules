
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * WORKLINK PRODUCTION-READY SECURITY RULES
     * Ensures all authenticated users can read and write workspace data.
     * v2: Explicitly allowing broad read access to resolve task/project list issues.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
