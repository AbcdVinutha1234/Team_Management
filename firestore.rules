
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WORKLINK SECURITY MODEL
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] != null;
    }

    function isAdmin(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] == 'Admin';
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; 
    }

    match /projects/{projectId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isMember(resource.data.members);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isAdmin(resource.data.members);

      match /memberships/{mUserId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isAdmin(request.resource.data.projectMembers);
      }
    }

    match /tasks/{taskId} {
      // Explicitly allow listing for signed-in users
      // Queries will still be filtered by assignedToId or projectId in the app
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        isAdmin(resource.data.projectMembers) || 
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
