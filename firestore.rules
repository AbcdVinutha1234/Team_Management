rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * WORKLINK LIVE PRODUCTION RULES
     * Allows all authenticated users full access to documents.
     * This ensures real-time listeners and dashboard queries function without permission errors.
     * Deployment heartbeat: 2024-03-24T10:00:00Z
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
