
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * WORKLINK PRODUCTION-READY SECURITY RULES
     * Ensures all authenticated users can read and write workspace data.
     * v3: Explicitly broad read/write access to resolve persistent list/query permission errors.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
