
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * WORKLINK SECURITY MODEL
     * Updated to provide robust permissions for real-time listing and document access.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap != null && memberMap[request.auth.uid] != null;
    }

    function isAdmin(memberMap) {
      return isSignedIn() && memberMap != null && (memberMap[request.auth.uid] == 'Admin' || memberMap[request.auth.uid] == 'Owner');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; 
    }

    match /projects/{projectId} {
      // Allow signed-in users to list and get projects.
      // Privacy is maintained by membership filters in the application queries.
      allow read: if isSignedIn();
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin(resource.data.members)
      );
      
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin(resource.data.members)
      );

      match /memberships/{mUserId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    match /tasks/{taskId} {
      // Explicitly allow list and get for authenticated users.
      // This supports real-time queries filtered by assignedToId or projectId.
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.assignedToId == request.auth.uid || 
        isMember(resource.data.projectMembers) ||
        resource.data.createdBy == request.auth.uid
      );
      
      allow delete: if isSignedIn() && (
        isAdmin(resource.data.projectMembers) || 
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
